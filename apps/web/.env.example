# Web App — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local to source control.

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ResearchTex

# --- Database (Phase 7+) ---
DATABASE_URL=

# --- Authentication (Phase 2+) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (Phase 2+) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Drive (Phase 8+) ---
NEXT_PUBLIC_GOOGLE_DRIVE_ENABLED=false

# --- AI (Phase 11+) ---
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
NEXT_PUBLIC_AI_ENABLED=false

# --- Local ResearchTex Agent (Phase 4+) ---
NEXT_PUBLIC_AGENT_BASE_URL=http://127.0.0.1:54731
NEXT_PUBLIC_AGENT_ENABLED=false
NEXT_PUBLIC_COMPILER_AGENT_URL=http://127.0.0.1:4433

# --- Collaboration Server (Phase 8+) ---
# Used by Next.js to flush editor state before compilation.
# Must match COLLABORATION_PORT and INTERNAL_API_KEY in apps/collaboration/.env
NEXT_PUBLIC_COLLABORATION_URL=ws://localhost:1234
INTERNAL_API_KEY=development_secret_key

# --- JWT (internal session token) ---
# Generate a random value: openssl rand -base64 32
JWT_SECRET=
